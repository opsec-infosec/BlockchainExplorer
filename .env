# Redis Server
# REDIS_MEM = % of system memory to use, default to 5%
REDIS_HOST=rds
REDIS_PORT=6379
REDIS_MEM=20

# Bitcoind block data files
DATA_PATH=/home/node/data/.bitcoin/blocks/
## Parse newest blocks first, if you are running bitcoind and syncing the block,
##  then you probably want this as false, that way we process bitcoind's .dat files
##  in the order they are created increasing from blk00000.dat
LATEST_FIRST=false

